# Copy to .env (read by the server). Never commit real secrets.

# Postgres connection
DATABASE_URL=postgres://localhost:5432/civitas

# Token signing secret. REQUIRED in production (any long random string: `openssl rand -hex 32`).
AUTH_SECRET=

PORT=3001

# Voice / video / screen share (LiveKit). Leave empty to run without media; the city still works.
# Local dev: `livekit-server --dev` gives ws://localhost:7880 with key "devkey" / secret "secret".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# AI, text + vision (city commands, photo analysis). Free key at console.groq.com. Without it an offline parser handles commands.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# AI, image editing (fountain studio: age / era / restyle). Key from aistudio.google.com. Paid models; without it those options are disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Set to "false" to skip creating the public demo rooms on boot.
SEED_DEMOS=true
